# ===== Allergy Guard (static HTML + Docker/nginx) =====

# --- Secrets / environment (เช่น API key ที่อาจเพิ่มในอนาคต) ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/
config.local.*

# --- Docker (local override) ---
docker-compose.override.yml
docker-compose.*.local.yml
.docker/

# --- OS files ---
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Editors / IDEs ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- Logs ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Node (ถ้ามีการใช้เครื่องมือ build/format ในอนาคต) ---
node_modules/
package-lock.json.bak
.npm/
.cache/
.parcel-cache/

# --- Build output ---
dist/
build/
.tmp/
tmp/

# --- Backup / temp files ---
*.bak
*.backup
*.orig
*.tmp
*.old
*.zip
*.tar
*.tar.gz